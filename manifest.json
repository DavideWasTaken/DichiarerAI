{
  "manifest_version": 3,
  "name": "DichiarerAI",
  "version": "1.0.0",
  "description": "Compila la dichiarazione dei redditi precompilata con l'aiuto dell'intelligenza artificiale (Claude o OpenAI).",
  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://dichiarazioneprecompilata.agenziaentrate.gov.it/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Apri DichiarerAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
